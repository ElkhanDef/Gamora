<UserControl x:Class="Gamora.App.Views.Admin.GameEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Gamora.App.ViewModels.Admin"
             d:DataContext="{d:DesignInstance Type=vm:GameEditViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,16,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderTitle}"
                   FontFamily="{StaticResource RajdhaniFont}"
                   FontSize="30"
                   Foreground="White"
                   Margin="32,28,32,0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,12,32,32" MaxWidth="560" HorizontalAlignment="Stretch">

                <TextBlock Text="Ad" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,4" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Oyun adı" />
                <TextBlock Text="{Binding NameError}"
                           Style="{StaticResource FieldNoteStyle}"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding NameError, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding DuplicateNameWarning}"
                           Style="{StaticResource FieldNoteStyle}"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding DuplicateNameWarning, Converter={StaticResource NullToVisibilityConverter}}" />

                <TextBlock Text="Kategori" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding Categories}"
                          Text="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Başlatma Tipi" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding LaunchTypeOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedLaunchType}" />

                <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource FieldLabelStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding LaunchTarget, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="Gözat"
                            Command="{Binding BrowseExeCommand}"
                            Margin="8,0,0,0"
                            Padding="16,0"
                            Cursor="Hand"
                            Foreground="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource AccentBrush}"
                            Background="Transparent"
                            Visibility="{Binding ShowBrowseButton, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
                <TextBlock Text="{Binding TargetHint}"
                           Style="{StaticResource FieldNoteStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding TargetHint, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding TargetError}"
                           Style="{StaticResource FieldNoteStyle}"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding TargetError, Converter={StaticResource NullToVisibilityConverter}}" />

                <ui:CardExpander Header="Gelişmiş"
                                  IsExpanded="{Binding IsAdvancedExpanded}"
                                  Margin="0,20,0,0">
                    <StackPanel Margin="2,8,2,4">
                        <TextBlock Text="Çalışma Dizini" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="(opsiyonel)" />
                        <TextBlock Text="Argümanlar" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="(opsiyonel)" />
                    </StackPanel>
                </ui:CardExpander>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Müşteri Ekranında" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:ToggleSwitch IsChecked="{Binding IsVisible}" OnContent="Görünür" OffContent="Gizli" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Sıra" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:NumberBox Value="{Binding SortOrderValue}" Minimum="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="18+ (yaş kısıtlı)"
                          IsChecked="{Binding AgeRestricted}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Margin="0,20,0,0" />

                <TextBlock Text="{Binding SaveErrorMessage}"
                           Style="{StaticResource FieldNoteStyle}"
                           Foreground="{StaticResource ErrorBrush}"
                           Margin="0,20,0,0"
                           Visibility="{Binding SaveErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Content="{Binding SaveButtonLabel}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            Padding="28,12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Foreground="White"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentBrush}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="İptal"
                            Command="{Binding CancelCommand}"
                            Margin="12,0,0,0"
                            Padding="28,12"
                            Cursor="Hand"
                            Foreground="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource AccentBrush}"
                            Background="Transparent" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
