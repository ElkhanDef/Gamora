<ui:FluentWindow x:Class="Gamora.App.Views.Admin.PasswordLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Gamora — Yönetici Girişi"
                 Width="380" Height="360"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <ui:TitleBar Title="" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="290">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="G" FontFamily="{StaticResource RajdhaniFont}" FontSize="24" Foreground="White" />
                    <TextBlock Text="A" FontFamily="{StaticResource RajdhaniFont}" FontSize="24" Foreground="White" Margin="2,0,0,0" />
                    <TextBlock Text="M" FontFamily="{StaticResource RajdhaniFont}" FontSize="24" Foreground="White" Margin="2,0,0,0" />
                    <TextBlock Text="O" FontFamily="{StaticResource RajdhaniFont}" FontSize="24" Foreground="White" Margin="2,0,0,0" />
                    <TextBlock Text="R" FontFamily="{StaticResource RajdhaniFont}" FontSize="24" Foreground="White" Margin="2,0,0,0" />
                    <TextBlock Text="A" FontFamily="{StaticResource RajdhaniFont}" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,0" />
                </StackPanel>
                <Rectangle Width="3" Height="18" Fill="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Rectangle.RenderTransform>
                        <SkewTransform AngleX="-18" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </StackPanel>

            <Border Background="{StaticResource CardBackgroundBrush}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Yönetici Girişi"
                               FontFamily="{StaticResource RajdhaniFont}"
                               FontSize="20"
                               Foreground="White" />

                    <TextBlock Text="Şifre" FontSize="12" Margin="0,16,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Şifre"
                                     IsEnabled="{Binding IsPasswordFieldEnabled}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                    <Button Content="Giriş"
                            Command="{Binding SubmitCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            Padding="0,14"
                            Margin="0,20,0,0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentBrush}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
