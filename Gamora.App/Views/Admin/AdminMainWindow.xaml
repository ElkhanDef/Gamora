<ui:FluentWindow x:Class="Gamora.App.Views.Admin.AdminMainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Gamora — Yönetici"
                 Width="1100" Height="700"
                 MinWidth="700" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar Title="" ShowMaximize="True">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="G" FontFamily="{StaticResource RajdhaniFont}" FontSize="18" Foreground="White" />
                            <TextBlock Text="A" FontFamily="{StaticResource RajdhaniFont}" FontSize="18" Foreground="White" Margin="2,0,0,0" />
                            <TextBlock Text="M" FontFamily="{StaticResource RajdhaniFont}" FontSize="18" Foreground="White" Margin="2,0,0,0" />
                            <TextBlock Text="O" FontFamily="{StaticResource RajdhaniFont}" FontSize="18" Foreground="White" Margin="2,0,0,0" />
                            <TextBlock Text="R" FontFamily="{StaticResource RajdhaniFont}" FontSize="18" Foreground="White" Margin="2,0,0,0" />
                            <TextBlock Text="A" FontFamily="{StaticResource RajdhaniFont}" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,0" />
                        </StackPanel>
                        <Rectangle Width="2" Height="14" Fill="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <SkewTransform AngleX="-18" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="YÖNETİCİ"
                                   FontFamily="{StaticResource RajdhaniFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <Border Height="1" VerticalAlignment="Bottom">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="{StaticResource AccentColor}" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Background="{StaticResource HeroBackgroundBrush}"
                     BorderThickness="0"
                     Padding="0,16"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="20,14" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedSection}"
                       FontFamily="{StaticResource RajdhaniFont}"
                       FontSize="32"
                       Foreground="White"
                       Margin="32,28,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
        </Grid>
    </Grid>
</ui:FluentWindow>
